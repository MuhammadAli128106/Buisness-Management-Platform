# Copy this file to server/.env for local development:
#   cp .env.example server/.env        (macOS / Linux / Git Bash)
#   copy .env.example server\.env      (Windows Command Prompt)
# On Railway, set the same names under Service -> Variables.
# NEVER commit the real .env file or paste secrets into git.

# Postgres connection string.
#   Railway (prod):  ${{Postgres.DATABASE_URL}}
#   Local dev:       the Postgres service's PUBLIC URL from Railway -> Postgres -> Connect
DATABASE_URL=

# Signs login tokens.  Generate with:  openssl rand -hex 32
JWT_SECRET=

# AES-256-GCM key that encrypts integration secrets and Google tokens.
# Generate with:  openssl rand -hex 32
APP_ENC_KEY=

# Public HTTPS address of the app, with NO trailing slash.
#   Railway:  https://<app>.up.railway.app
#   Local:    your tunnel URL, e.g. from  cloudflared tunnel --url http://localhost:8080
PUBLIC_URL=

# "production" on Railway, "development" locally.
NODE_ENV=development

# Google OAuth client for Google Calendar
# (platform level; each employee consents individually).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Railway sets this automatically. Local default is 8080.
PORT=8080

# Telegram and Google Pay credentials are NOT set here.
# They are per workspace and entered on Settings -> Integrations,
# where they are stored encrypted in the database.
# (Google Pay runs in TEST mode only: no real money is ever charged.)
